@{
    ViewBag.Title = "Login Admin";
}

<div class="login-page">
    <div class="login-card">
        <div class="login-card__header">
            <div class="logo logo--center">
                <img class="logo__mark" src="/images/MENDE_LOGO.jpeg_page-0001.jpg" alt="Logo Mendê Pizzaria">
                <span class="logo__text">Mendê Pizzaria</span>
            </div>
            <h1>Acesso Administrativo 🔒</h1>
            <p>Entre com suas credenciais para acessar o painel.</p>
        </div>

        <form class="login-form" onsubmit="return adminLogin(event)">
            <div id="login-error" class="login-error" style="display:none;"></div>

            <div class="form-group">
                <label for="username">Usuário</label>
                <input type="text" id="username" name="username" placeholder="admin" autocomplete="off" required />
            </div>

            <div class="form-group">
                <label for="password">Senha</label>
                <input type="password" id="password" name="password" placeholder="Sua senha" required />
            </div>

            <button type="submit" class="btn btn--primary btn--full">
                Entrar
            </button>
        </form>

    </div>
</div>

<script>
    function adminLogin(event) {
        event.preventDefault();

        var user = document.getElementById("username").value.trim();
        var pass = document.getElementById("password").value;
        var errorEl = document.getElementById("login-error");

        if (user === "admin" && pass === "admin") {
            sessionStorage.setItem("pi_admin_auth", "1");
            window.location.href = "/Admin";
            return false;
        }

        errorEl.textContent = "Usuário ou senha incorretos.";
        errorEl.style.display = "block";
        return false;
    }
</script>
